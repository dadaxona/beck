{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "nodemon index.js",
    "electron": "electron .",
    "build": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "iconv-lite": "^0.7.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.2C",
    "productName": "2C",
    "icon": "icon.ico",
    "asar": false,
    "win": {
      "icon": "icon.ico",
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "2C",
      "license": "license.md",
      "installerHeaderIcon": "icon.ico",
      "uninstallDisplayName": "2C"
    },
    "afterPack": "./build/afterPack.js"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "electron@45.4.1": true
  }
}
